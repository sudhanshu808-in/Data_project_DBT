# Copy to .env (never commit .env). Values are examples only.

# Neon: generator connection (pooled endpoint is fine; initial load should use the direct one)
NEON_DATABASE_URL=postgresql://generator:<password>@<endpoint>.neon.tech/neondb?sslmode=require
NEON_DIRECT_URL=postgresql://generator:<password>@<endpoint-direct>.neon.tech/neondb?sslmode=require

# Databricks (used by Airflow and dbt; Airflow reads these from airflow/.env)
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
